APP_NAME="Canovia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production public origin / legacy-domain migration
CANOVIA_CANONICAL_URL=https://app.canovia.com
CANOVIA_LEGACY_HOSTS=pacekeeper-d3mm.onrender.com
CANOVIA_REDIRECT_LEGACY_HOSTS=true
CANOVIA_APP_VERSION=v29
CANOVIA_SUPPORT_EMAIL=
CANOVIA_OPERATOR_NAME=Canovia
CANOVIA_SUPER_ADMIN_USER_ID=
CANOVIA_ADMIN_EMAIL=
TEMPLATE_ADMIN_PASSWORD=change-this-password

# V41.8 Native AI Practice (disabled until a server-side API key is configured)
CANOVIA_NATIVE_AI_DRIVER=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CANOVIA_NATIVE_AI_MODEL=gpt-5.6-luna
CANOVIA_NATIVE_AI_TIMEOUT_SECONDS=45
CANOVIA_NATIVE_AI_STANDARD_GENERATION_MAX_OUTPUT_TOKENS=8000
CANOVIA_NATIVE_AI_STANDARD_ASSESSMENT_MAX_OUTPUT_TOKENS=6000
CANOVIA_NATIVE_AI_BOOSTED_GENERATION_MAX_OUTPUT_TOKENS=12000
CANOVIA_NATIVE_AI_BOOSTED_ASSESSMENT_MAX_OUTPUT_TOKENS=8000

# V58 MCP OAuth discovery probe (OFF by default: NOT a working ChatGPT connector)
# Configure only after choosing a real OAuth 2.1 authorization server.
# Even when enabled, /api/mcp ALWAYS returns 401 until token verification,
# explicit consent and a reviewed MCP tool handler are implemented.
CANOVIA_MCP_DISCOVERY_ENABLED=false
CANOVIA_MCP_RESOURCE_URL=
CANOVIA_MCP_OAUTH_ISSUER=

# V46.3 GitHub Repository Inspection
# Public repositories work without a token. This optional service-owned read token only raises
# API limits; it is not a per-user private-repository credential.
GITHUB_API_URL=https://api.github.com
GITHUB_READ_TOKEN=

# V46.4 GitHub App Write Layer
# Configure a GitHub App with Metadata: read, Contents: read/write, Pull requests: read/write.
# V46.7 Review / Merge Return works with those permissions.
# Optional CI visibility can additionally use Actions: read, Checks: read, Commit statuses: read.
# Prefer the base64 form on hosts where multiline environment variables are awkward.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_INSTALL_URL=
# Shared secret configured on the GitHub App webhook. Server-side only.
GITHUB_APP_WEBHOOK_SECRET=
# Configure the GitHub App "Setup URL" to:
# https://<your-canovia-host>/github-workflow/github-app/setup
# V46.5 does not require "Redirect on update"; users can re-check connection in Canovia.

APP_LOCALE=en
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Core page performance diagnostics. Production defaults to enabled during V41.17 diagnosis.
# Set false on Render when the measurement window is complete.
PERFORMANCE_LOG_ENABLED=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Reuse MySQL connections across PHP-FPM requests when the DB is remote.
DB_PERSISTENT=false

SESSION_DRIVER=database
# For production low-latency sessions: SESSION_DRIVER=redis and SESSION_CONNECTION=default
SESSION_CONNECTION=
SESSION_LIFETIME=10080
SESSION_EXPIRE_ON_CLOSE=false
# Keep this legacy cookie name during the domain migration so existing sessions can be handed over safely.
SESSION_COOKIE=pace-keeper-session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PERSISTENT=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FEATURE_CANOVIA_AI=false
